# Studio only — never configure carrier routing flags on this service.
NODE_ENV=production
PORT=3000
STUDIO_PUBLIC_ORIGIN=https://agentbridge.victor.ceo
STUDIO_DATABASE_PATH=/data/studio.sqlite
# Generate privately: npm run studio:key
STUDIO_ACCESS_KEY_SHA256=
# Optional read-only connection to an existing private AgentBridge Worker:
AGENTBRIDGE_BACKEND_URL=
AGENTBRIDGE_ACCOUNT_TOKEN=

# Public email signup on Node/Railway. Omit to retain the existing access mode.
STUDIO_SIGNUP_MODE=
# Sending-only Resend key, restricted to the verified sending domain.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Enable only for Railway's public HTTP edge, with no untrusted direct/private
# access to this service. Requires Railway's RAILWAY_ENVIRONMENT_ID as well.
STUDIO_TRUST_RAILWAY_PROXY=

# Legacy single-tester account, used when public signup is not enabled.
# Set to the one email permitted to register; leave empty for operator mode.
DEMO_TESTER_EMAIL=
STUDIO_ACCOUNT_DATABASE_PATH=/data/accounts.sqlite
# One-time signup invitation hash; use the invite script to generate locally.
# Required for the legacy single-tester password invitation flow only.
DEMO_SIGNUP_INVITE_SHA256=

# Server-only AES-256 wrapping key for customer-supplied SignalWire credentials.
# Exactly 32 random bytes encoded as 64 hexadecimal characters. Store as a host
# secret; never commit a value. Keep the same key across redeploys/restarts.
PROVIDER_CREDENTIALS_KEY=
