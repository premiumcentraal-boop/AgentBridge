{
  // Copy to backend/wrangler.jsonc (git-ignored) and fill in. Secrets go in
  // `wrangler secret put`, never here: SIGNALWIRE_SIGNING_KEY, OWNER_APPROVAL_TOKEN_SHA256,
  // (optional) SIGNALWIRE_API_TOKEN, TWILIO_AUTH_TOKEN.
  "name": "agentbridge-api",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-08",
  "workers_dev": false,
  "d1_databases": [{"binding":"DB","database_name":"agentbridge-prototype","database_id":"REPLACE_WITH_YOUR_D1_DATABASE_ID"}],
  "vars": {
    "PUBLIC_BASE_URL": "https://api.example.com",
    "US_BRIDGE_DID": "+12025550123",
    "TEST_DESTINATION_E164": "+31201234567",
    "TEST_CALLER_E164": "+12125550177",

    // SignalWire (docs/SIGNALWIRE.md, docs/ROUTING_PLAN.md)
    "SIGNALWIRE_PROJECT_ID": "REPLACE_WITH_PROJECT_UUID",
    "SIGNALWIRE_SWML_WEBHOOK_URL": "https://api.example.com/telephony/signalwire/swml",

    // Owner policy (placeholders; owner must fill from SignalWire pricing with a source/date)
    "ROUTING_DESTINATIONS": "[{\"e164\":\"+12125550100\",\"country\":\"US\",\"rate_cents_per_min\":0,\"rate_source\":\"REPLACE: SignalWire rate + date\"}]",
    "ROUTING_ALLOWED_COUNTRIES": "US",
    "ROUTING_MAX_CALL_SECONDS": "180",
    "ROUTING_MAX_CALLS_PER_DAY": "3",
    "ROUTING_MAX_SPEND_CENTS_PER_CALL": "REPLACE",
    "ROUTING_MAX_SPEND_CENTS_PER_DAY": "REPLACE",
    "RESERVATION_TTL_SECONDS": "240",

    // Caller proof: "dtmf_pin" or "capped_caller_id" (the latter also needs CALLER_ID_TRUST_ACCEPTED="true").
    // Unset = no routing.
    "CALLER_PROOF_MODE": "",
    "CALLER_ID_TRUST_ACCEPTED": "",

    // OWNER KILL SWITCHES: routing happens only when BOTH are exactly "true". Leave empty.
    "PRIVATE_TEST_OUTBOUND_ENABLED": "",
    "SIGNALWIRE_CONNECT_ENABLED": ""
  }
}
